# Copy this file to .env.deploy on the server and fill real values.

NACOS_SERVER_ADDR=nacos.linqin.space
NACOS_NAMESPACE=minipay
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# Used by docker-compose redis service and Nacos redis.yml if you reference env vars.
REDIS_PASSWORD=yi111111lin

# If services run in this compose file, keep RocketMQ as rocketmq-namesrv:9876.
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876

# Optional JVM tuning for small servers.
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m
